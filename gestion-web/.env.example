# Copiar a .env.local (desarrollo) o cargar en Easypanel > App > Environment.
# Nunca subir los valores reales al repositorio.

# --- Base propia del panel (servicio MariaDB dentro de Easypanel) ---
PANEL_DB_HOST=gestion-web_panel-db
PANEL_DB_PORT=3306
PANEL_DB_NAME=gestion_web_panel
PANEL_DB_USER=gw_panel
PANEL_DB_PASSWORD=

# --- Base del sistema de gestión viejo (fuera de Easypanel, por VPN) ---
# IP de la VPN (ej. Tailscale 100.x.x.x) del servidor donde corre MariaDB
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
# usuario con SOLO SELECT (ver db/legacy/crear-usuarios.sql)
LEGACY_DB_READ_USER=gw_lectura
LEGACY_DB_READ_PASSWORD=
# usuario con SELECT/INSERT/UPDATE/DELETE; solo se usa en modo escritura
LEGACY_DB_WRITE_USER=gw_escritura
LEGACY_DB_WRITE_PASSWORD=

# --- Sesión del panel ---
# mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# en Easypanel (HTTPS) dejar true; en local por http poner false
COOKIE_SECURE=true

# --- Administrador inicial (se crea solo si la tabla usuarios está vacía) ---
ADMIN_EMAIL=
ADMIN_NOMBRE=Administrador
# mínimo 10 caracteres
ADMIN_PASSWORD=
